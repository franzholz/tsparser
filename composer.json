{
  "name": "jambagecom/tsparser",
  "type": "typo3-cms-extension",
  "description": "More Constants Editor Types for TYPO3 CMS",
  "keywords": [
    "TYPO3",
    "extension",
    "constant-editor"
  ],
  "support": {
    "issues": "https://github.com/franzholz/tsparser/issues"
  },
  "homepage": "https://jambage.com",
  "authors": [
    {
      "name": "Franz Holzinger",
      "role": "Developer",
      "homepage": "https://jambage.com"
    }
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4 || ^14.3"
  },
  "autoload": {
    "psr-4": {
      "JambageCom\\Tsparser\\": "Classes"
    }
  },
  "replace": {
    "typo3-ter/tsparser": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "tsparser",
      "version": "1.0.0"
    }
  },
  "require-dev": {
    "rector/rector": "^0.18.13"
  },
  "config": {
    "allow-plugins": {
      "typo3/cms-composer-installers": true
    }
  }
}
